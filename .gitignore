# ==============================================================================
# SMANV EduERP - Enterprise Modular Monolith Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Frontend (Expo / React Native / Node.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
lerna-debug.log*

# Expo & Metro
.expo/
frontend/.expo/
dist/
frontend/dist/
web-build/
frontend/web-build/
expo-env.d.ts
frontend/expo-env.d.ts
.metro-health-check*
frontend/.metro-health-check*

# TypeScript
*.tsbuildinfo
frontend/*.tsbuildinfo

# Native Builds & Keystores
.kotlin/
frontend/.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.mobileprovision
/ios/
/android/
frontend/ios/
frontend/android/

# ------------------------------------------------------------------------------
# Backend (Python / Django / Celery / SQLite / Media)
# ------------------------------------------------------------------------------
# Python byte code & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
bin/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Django local database & static/media uploads
*.sqlite3
backend/*.sqlite3
backend/db.sqlite3
backend/media/
backend/staticfiles/
!backend/media/.gitkeep
!backend/staticfiles/.gitkeep

# Backend logs & Celery
*.log
backend/logs/*.log
!backend/logs/.gitkeep
celerybeat-schedule*
backend/celerybeat-schedule*

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Documentation & Scratch Files
backend/schema.yml
