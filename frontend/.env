# Base URL for Django REST Framework (DRF) backend
# In Expo SDK, variables prefixed with EXPO_PUBLIC_ are available in application code.
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - iOS Simulator / Web: http://127.0.0.1:8000/api/v1
# - Physical Devices: http://<YOUR_LOCAL_NETWORK_IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
